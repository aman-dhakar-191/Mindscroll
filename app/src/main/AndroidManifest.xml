    <!-- Firebase diagnostics upload crash reports and technical service events when enabled. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Update chip by the camera (Android 16+). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lists launchable apps for "Apps to track" (and their names) without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MindscrollApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mindscroll">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!--
            One launcher entry per character and colour set; exactly one is enabled (LauncherIcon
            switches them, and only while the app is out of sight). Mo in Classic is the default.
            Each carries that character's icon in that colour, so the logo is the user's pick.
        -->
